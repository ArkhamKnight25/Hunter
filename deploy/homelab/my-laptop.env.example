# ─────────────────────────────────────────────────────────────────────────
# MY LAPTOP BACKEND ENV  (Vercel frontend + laptop backend, no domain)
# ─────────────────────────────────────────────────────────────────────────
# Architecture:
#   Browser -> Vercel (Next.js frontend + BFF proxy)
#                 └─ BFF -> Cloudflare Tunnel URL -> this laptop's Django :8000
#   Laptop runs: django, mysql, redis, celery-worker, celery-beat
#   (NO frontend container, NO Traefik — those need a domain.)
#
# Copy to `my-laptop.env` (gitignored) and fill the real secrets.
# Bring up with: docker compose --env-file my-laptop.env -f my-laptop.compose.yml up -d

# --- Your GHCR images (built by your GitHub Actions on push to main) ---
JOBHUNT_IMAGE=ghcr.io/arkhamknight25/hunter
JOBHUNT_TAG=india-hunter

# --- Storage on the laptop (absolute paths; create these dirs first) ---
# Example Linux/WSL: /home/youruser/hunter-data/mysql
JOBHUNT_MYSQL_DATA_LOCATION=./data/mysql
JOBHUNT_REDIS_DATA_LOCATION=./data/redis

# --- MySQL ---
JOBHUNT_MYSQL_DATABASE=jobhunt_db
JOBHUNT_MYSQL_USER=jobhunt_user
JOBHUNT_MYSQL_PASSWORD=CHANGE_ME_strong_password
JOBHUNT_MYSQL_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# --- Django ---
JOBHUNT_DJANGO_SECRET_KEY=CHANGE_ME_django_secret
# ALLOWED_HOSTS: localhost + your Cloudflare Tunnel hostname (no https://, no path)
#   e.g. hunter-api.trycloudflare.com  OR  your-named-tunnel.example
JOBHUNT_ALLOWED_HOSTS=localhost,django,127.0.0.1,CHANGE_ME_tunnel_host
# CSRF: full origin of your Vercel app (with https://)
#   e.g. https://hunter-yourname.vercel.app
JOBHUNT_CSRF_TRUSTED_ORIGINS=https://CHANGE_ME_your_app.vercel.app

# --- Secrets / integrations ---
JOBHUNT_APIFY_API_TOKEN=CHANGE_ME_apify_token
# Single key (simplest):
JOBHUNT_OPENAI_API_KEY=CHANGE_ME_openai_key
# OR multiple keys for auto-rotation on exhaustion/rate-limit (comma-separated).
# If set, takes priority; leave JOBHUNT_OPENAI_API_KEY empty or keep both.
JOBHUNT_OPENAI_API_KEYS=
JOBHUNT_DISCORD_WEBHOOK_URL=
JOBHUNT_DISCORD_TOP_N_JOBS=20
